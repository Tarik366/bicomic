{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Tarik366/bicomic/refs/heads/master/schema.json",
  "title": "Bicomic Metadata",
  "description": "A metadata file from multi-lingual bicomic archive",
  "type": "object",
  "properties": {
    "titles": {
      "$schema": "https://raw.githubusercontent.com/Tarik366/bicomic/refs/heads/master/languageObject.json",
      "description": "Titles of books. like `'eng': 'A Witch's Life in Mongol'`",
      "type": "object"
      },
    "supportedLanguages": {
      "description": "List of files supported languages",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "array",
      "properties": {
        "iframe": {
          "type": "string",
          "description": "Html string of iframe should seen in after the episode"
        }
      }
    }
  }
}

